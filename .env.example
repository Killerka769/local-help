# Скопируйте в .env и .env.local. На Vercel — Environment Variables.
# Не коммитьте настоящие значения.

# ОБЯЗАТЕЛЬНО. PostgreSQL. Prisma 7 читает URL из prisma.config.ts.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/localhelp?sslmode=require"

# ОБЯЗАТЕЛЬНО. Подпись JWT, минимум 32 символа.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="замените_на_случайную_строку_длиннее_32_символов"

# ОБЯЗАТЕЛЬНО на проде. Authorization: Bearer CRON_SECRET для /api/cron/expire-requests
CRON_SECRET="замените_на_случайную_строку"

# Необязательно, пока нет своего домена. Пусто = noindex.
# После покупки: https://ваш-домен.ru без слэша.
NEXT_PUBLIC_SITE_URL=""

# ОБЯЗАТЕЛЬНО перед людьми. Один контакт поддержки (почта или @telegram).
NEXT_PUBLIC_SUPPORT_CONTACT="support@example.com"
SUPPORT_CONTACT="support@example.com"

# Почта выключена. Не включать без домена и рабочей доставки в Mail.ru/Яндекс.
# RESEND_API_KEY=""
# EMAIL_FROM=""
